<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Concern act completed + allergy observation with effectiveTime/high maps clinicalStatus to resolved">
        <x:context select="//cda:observation[cda:templateId/@root='2.16.840.1.113883.10.20.22.4.7']">
            <entry xmlns="urn:hl7-org:v3"><act classCode="ACT" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.30"/><id root="a1000000-0000-0000-0000-000000000001"/>
            <code code="CONC" codeSystem="2.16.840.1.113883.5.6"/><statusCode code="completed"/>
            <effectiveTime><low value="20240101"/><high value="20250101"/></effectiveTime>
            <entryRelationship typeCode="SUBJ"><observation classCode="OBS" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.7"/><id root="a1000000-0000-0000-0000-000000000002"/>
            <code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4"/><statusCode code="completed"/>
            <effectiveTime><low value="20240101"/><high value="20250101"/></effectiveTime>
            <value xsi:type="CD" code="419511003" codeSystem="2.16.840.1.113883.6.96" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
            <participant typeCode="CSM"><participantRole classCode="MANU"><playingEntity classCode="MMAT">
            <code code="7980" codeSystem="2.16.840.1.113883.6.88" displayName="penicillin"/></playingEntity></participantRole></participant>
            </observation></entryRelationship></act></entry>
        </x:context>
        <x:expect label="Should produce an AllergyIntolerance"
            test="count(fhir:AllergyIntolerance) = 1" />
        <x:expect label="clinicalStatus should be 'resolved' (concern completed + allergy effectiveTime/high)"
            test="count(fhir:AllergyIntolerance/fhir:clinicalStatus/fhir:coding/fhir:code[@value = 'resolved']) = 1" />
        <x:expect label="clinicalStatus must be from the allergyintolerance-clinical value set (was the raw ActStatus 'completed')"
            test="count(fhir:AllergyIntolerance/fhir:clinicalStatus/fhir:coding/fhir:code[@value = ('active','inactive','resolved')]) = 1" />
    </x:scenario>

    <x:scenario label="Concern act active maps clinicalStatus to active">
        <x:context select="//cda:observation[cda:templateId/@root='2.16.840.1.113883.10.20.22.4.7']">
            <entry xmlns="urn:hl7-org:v3"><act classCode="ACT" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.30"/><id root="a2000000-0000-0000-0000-000000000001"/>
            <code code="CONC" codeSystem="2.16.840.1.113883.5.6"/><statusCode code="active"/>
            <effectiveTime><low value="20240101"/></effectiveTime>
            <entryRelationship typeCode="SUBJ"><observation classCode="OBS" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.7"/><id root="a2000000-0000-0000-0000-000000000002"/>
            <code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4"/><statusCode code="completed"/>
            <effectiveTime><low value="20240101"/></effectiveTime>
            <value xsi:type="CD" code="419511003" codeSystem="2.16.840.1.113883.6.96" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
            <participant typeCode="CSM"><participantRole classCode="MANU"><playingEntity classCode="MMAT">
            <code code="7980" codeSystem="2.16.840.1.113883.6.88" displayName="penicillin"/></playingEntity></participantRole></participant>
            </observation></entryRelationship></act></entry>
        </x:context>
        <x:expect label="clinicalStatus should be 'active'"
            test="count(fhir:AllergyIntolerance/fhir:clinicalStatus/fhir:coding/fhir:code[@value = 'active']) = 1" />
    </x:scenario>

    <x:scenario label="Concern act completed without an allergy end date maps clinicalStatus to inactive">
        <x:context select="//cda:observation[cda:templateId/@root='2.16.840.1.113883.10.20.22.4.7']">
            <entry xmlns="urn:hl7-org:v3"><act classCode="ACT" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.30"/><id root="a3000000-0000-0000-0000-000000000001"/>
            <code code="CONC" codeSystem="2.16.840.1.113883.5.6"/><statusCode code="completed"/>
            <effectiveTime><low value="20240101"/></effectiveTime>
            <entryRelationship typeCode="SUBJ"><observation classCode="OBS" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.7"/><id root="a3000000-0000-0000-0000-000000000002"/>
            <code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4"/><statusCode code="completed"/>
            <effectiveTime><low value="20240101"/></effectiveTime>
            <value xsi:type="CD" code="419511003" codeSystem="2.16.840.1.113883.6.96" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
            <participant typeCode="CSM"><participantRole classCode="MANU"><playingEntity classCode="MMAT">
            <code code="7980" codeSystem="2.16.840.1.113883.6.88" displayName="penicillin"/></playingEntity></participantRole></participant>
            </observation></entryRelationship></act></entry>
        </x:context>
        <x:expect label="clinicalStatus should be 'inactive'"
            test="count(fhir:AllergyIntolerance/fhir:clinicalStatus/fhir:coding/fhir:code[@value = 'inactive']) = 1" />
    </x:scenario>

</x:description>
