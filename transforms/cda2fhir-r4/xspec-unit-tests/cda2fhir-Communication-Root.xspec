<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" 
    xmlns:lcg="http://www.lantanagroup.com" stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

  <x:scenario label="A. Act that matches 'cda:act[cda:templateId[@root='2.16.840.1.113883.10.20.22.4.141']]">
    <x:context>
      <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
        <!-- [C-CDA R2.0] Handoff Communication Participants -->
        <templateId root="2.16.840.1.113883.10.20.22.4.141" />
        <!-- DataElement: Hand off ID-->
        <id root="d839038b-2456-AABD-1c6a-467925b43857" />
        <code code="432138007" codeSystem="2.16.840.1.113883.6.96" codeSystemName="SNOMED CT" displayName="handoff communication (procedure)" />
        <statusCode code="completed" />
        <!-- DataElement: Time of Handoff -->
        <effectiveTime value="20161201" />
        <!-- DataElement: Author Participation (care coordination) -->
        <author typeCode="AUT">
          <!-- [C-CDA R2.0] Author Participation -->
          <templateId root="2.16.840.1.113883.10.20.22.4.119" />
          <time value="20161201" />
          <assignedAuthor>
            <id root="d839038b-7171-4165-a760-467925b43857" />
            <code code="163W00000X" codeSystem="2.16.840.1.113883.6.101" codeSystemName="Healthcare Provider Taxonomy (HIPAA)" displayName="Registered nurse" />
            <assignedPerson>
              <name>
                <given>Nurse</given>
                <family>Florence</family>
                <suffix>RN</suffix>
              </name>
            </assignedPerson>
          </assignedAuthor>
        </author>
        <!-- DataElement: Participant -->
        <participant typeCode="IRCP">
          <participantRole>
            <!-- DataElement: Participant ID -->
            <id extension="1138345" root="2.16.840.1.113883.19" />
            <!-- DataElement: Participant Role -->
            <code code="163W00000X" codeSystem="2.16.840.1.113883.6.101" codeSystemName="NUCC Health Care Provider Taxonomy" displayName="Registered Nurse" />
            <!-- DataElement: Participant Address -->
            <addr>
              <streetAddressLine>1006 Health Drive</streetAddressLine>
              <city>Ann Arbor</city>
              <state>MI</state>
              <postalCode>97867</postalCode>
              <country>US</country>
            </addr>
            <telecom value="tel:+1(555)555-1014" use="WP" />
            <playingEntity>
              <!-- DataElement: Participant Name -->
              <name>
                <family>Nancy</family>
                <given>Nightingale</given>
                <suffix>RN</suffix>
              </name>
            </playingEntity>
          </participantRole>
        </participant>
      </act>
    </x:context>

    <x:expect label="A1. Should produce a Communication resource" test="count(fhir:Communication) = 1" />
    <x:expect label="A2. Should have one identifier with the correct system and a value" test="fhir:Communication/fhir:identifier">
      <identifier xmlns="http://hl7.org/fhir">
        <system value="urn:ietf:rfc:3986" />
        <value value="..." />
      </identifier>
    </x:expect>
    <x:expect label="A3. Should have a single status" test="count(fhir:Communication/fhir:status)=1" />
    <!-- 20260729 Claude: Fix - assertion was always-true: count() of a comparison counts a boolean (=1 regardless); comparison moved into a predicate -->
    <x:expect label="A4. Should have a status of completed" test="count(fhir:Communication/fhir:status[@value = 'completed']) = 1" />
    <!-- 20260729 Claude: Fix - assertion was always-true: count() of a comparison counts a boolean (=1 regardless); comparison moved into a predicate -->
    <x:expect label="A5. Should have a sent date" test="count(fhir:Communication/fhir:sent[@value = '2016-12-01']) = 1" />
    <!-- 20260729 Claude: Fix - assertion was always-true: count() of a comparison counts a boolean (=1 regardless); comparison moved into a predicate -->
    <x:expect label="A6. Should have the correct reason" test="count(fhir:Communication/fhir:reasonCode/fhir:coding/fhir:code[@value = '432138007']) = 1" />
  </x:scenario>

  <x:scenario label="B. Act that matches 'cda:act[cda:templateId[@root='2.16.840.1.113883.10.20.22.4.141']]' and mode 'bundle-entry'">
    <x:context mode="bundle-entry">
      <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
        <!-- [C-CDA R2.0] Handoff Communication Participants -->
        <templateId root="2.16.840.1.113883.10.20.22.4.141" />
        <!-- DataElement: Hand off ID-->
        <id root="d839038b-2456-AABD-1c6a-467925b43857" />
        <code code="432138007" codeSystem="2.16.840.1.113883.6.96" codeSystemName="SNOMED CT" displayName="handoff communication (procedure)" />
        <statusCode code="completed" />
        <!-- DataElement: Time of Handoff -->
        <effectiveTime value="20161201" />
        <!-- DataElement: Author Participation (care coordination) -->
        <author typeCode="AUT">
          <!-- [C-CDA R2.0] Author Participation -->
          <templateId root="2.16.840.1.113883.10.20.22.4.119" />
          <time value="20161201" />
          <assignedAuthor>
            <id root="d839038b-7171-4165-a760-467925b43857" />
            <code code="163W00000X" codeSystem="2.16.840.1.113883.6.101" codeSystemName="Healthcare Provider Taxonomy (HIPAA)" displayName="Registered nurse" />
            <assignedPerson>
              <name>
                <given>Nurse</given>
                <family>Florence</family>
                <suffix>RN</suffix>
              </name>
            </assignedPerson>
          </assignedAuthor>
        </author>
        <!-- DataElement: Participant -->
        <participant typeCode="IRCP">
          <participantRole>
            <!-- DataElement: Participant ID -->
            <id extension="1138345" root="2.16.840.1.113883.19" />
            <!-- DataElement: Participant Role -->
            <code code="163W00000X" codeSystem="2.16.840.1.113883.6.101" codeSystemName="NUCC Health Care Provider Taxonomy" displayName="Registered Nurse" />
            <!-- DataElement: Participant Address -->
            <addr>
              <streetAddressLine>1006 Health Drive</streetAddressLine>
              <city>Ann Arbor</city>
              <state>MI</state>
              <postalCode>97867</postalCode>
              <country>US</country>
            </addr>
            <telecom value="tel:+1(555)555-1014" use="WP" />
            <playingEntity>
              <!-- DataElement: Participant Name -->
              <name>
                <family>Nancy</family>
                <given>Nightingale</given>
                <suffix>RN</suffix>
              </name>
            </playingEntity>
          </participantRole>
        </participant>
      </act>
    </x:context>
    
    <x:expect label="B1. Should produce one Communication resource" test="count(fhir:entry/fhir:resource/fhir:Communication) = 1" />
  </x:scenario>

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the
         corrected behavior and fails against the pre-fix code -->

    <x:scenario label="Instruction act (4.20) statusCode active maps status to in-progress (was raw ActStatus copy)">
        <x:context>
            <act classCode="ACT" moodCode="INT" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.20"/><id root="10000000-0000-0000-0000-000000000001"/>
            <code code="311401005" codeSystem="2.16.840.1.113883.6.96" displayName="Patient education"/>
            <statusCode code="active"/></act>
        </x:context>
        <x:expect label="status should be 'in-progress', not the raw ActStatus 'active'"
            test="count(fhir:Communication/fhir:status[@value = 'in-progress']) = 1" />
    </x:scenario>

    <x:scenario label="Instruction act nested in a clinical statement gets a single partOf; standalone gets none">
        <x:context select="//cda:act[cda:templateId/@root='2.16.840.1.113883.10.20.22.4.20']">
            <substanceAdministration classCode="SBADM" moodCode="INT" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.16"/><id root="20000000-0000-0000-0000-000000000001"/>
            <statusCode code="active"/>
            <entryRelationship typeCode="SUBJ" inversionInd="true"><act classCode="ACT" moodCode="INT">
            <templateId root="2.16.840.1.113883.10.20.22.4.20"/><id root="20000000-0000-0000-0000-000000000002"/>
            <code code="311401005" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="completed"/>
            </act></entryRelationship></substanceAdministration>
        </x:context>
        <x:expect label="Exactly one partOf pointing at the containing clinical statement (was ../../../cda:* selecting ALL children of the great-grandparent)"
            test="count(fhir:Communication/fhir:partOf) = 1" />
    </x:scenario>

    <x:scenario label="Standalone Instruction act gets no partOf">
        <x:context>
            <act classCode="ACT" moodCode="INT" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.20"/><id root="30000000-0000-0000-0000-000000000001"/>
            <code code="311401005" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="completed"/></act>
        </x:context>
        <x:expect label="No containing clinical statement, so no partOf"
            test="count(fhir:Communication/fhir:partOf) = 0" />
    </x:scenario>

</x:description>
