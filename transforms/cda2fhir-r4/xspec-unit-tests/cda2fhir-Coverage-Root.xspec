<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" xmlns:lcg="http://www.lantanagroup.com" stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">

    <!-- Coverage - create bundle entry-->
    <x:scenario label="A. Scenario for testing template 'cda:act[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.60'][@moodCode = 'EVN']' and mode 'bundle-entry'">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_CDAR2_IG_CCDA_MTM_CAREPLAN.xml" />

        <x:expect label="A1. There should be one Coverages resource" test="count(//fhir:entry/fhir:resource/fhir:Coverage) = 1" />
    </x:scenario>

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the
         corrected behavior and fails against the pre-fix code -->

    <x:scenario label="Policy Activity statusCode cancelled maps Coverage.status to cancelled (was hard-coded active)">
        <x:context>
            <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.61"/><id root="50000000-0000-0000-0000-000000000001"/>
            <code code="SELF" codeSystem="2.16.840.1.113883.5.111"/><statusCode code="cancelled"/>
            <performer typeCode="PRF"><templateId root="2.16.840.1.113883.10.20.22.4.87"/>
            <assignedEntity><id root="50000000-0000-0000-0000-000000000002"/>
            <code code="PAYOR" codeSystem="2.16.840.1.113883.5.110"/></assignedEntity></performer>
            <participant typeCode="COV"><participantRole classCode="PAT">
            <id root="50000000-0000-0000-0000-000000000003" extension="MEM12345"/>
            <code code="SELF" codeSystem="2.16.840.1.113883.5.111"/></participantRole></participant></act>
        </x:context>
        <x:expect label="status should be 'cancelled'"
            test="count(fhir:Coverage/fhir:status[@value = 'cancelled']) = 1" />
    </x:scenario>

    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-B9: "these transforms are only for
         eCR"): the four Pharmacist Care Plan (PhCP) keys were removed from template-profile-mapping.xml.
         PhCP is not a dependency of the eCR IG, and the keys stamped PhCP profiles on resources in eICR
         bundles (PhCP-Coverage on every Coverage built from a Policy Activity 2015-08-01). The hard-coded
         Da Vinci hrex-coverage profile for Dental Data Exchange documents was removed for the same reason. -->
    <x:scenario label="B. no Pharmacist Care Plan or Da Vinci profile is claimed (RT-B9)">
        <x:scenario label="B1. Coverage from a Policy Activity 2015-08-01 in an eICR">
            <x:context href="../../integration-tests/documents/testCov.xml" />
            <x:expect label="B1a. the Coverage is still created" test="count(//fhir:entry/fhir:resource/fhir:Coverage) = 1" />
            <x:expect label="B1b. it claims no profile" test="count(//fhir:Coverage/fhir:meta/fhir:profile) = 0" />
            <x:expect label="B1c. no PhCP profile anywhere in the bundle" test="count(//fhir:profile[contains(@value, '/us/phcp/')]) = 0" />
        </x:scenario>
        <x:scenario label="B2. the C-CDA care plan test document">
            <x:context href="../../../samples/cda/xspec-test-files/XSPEC_CDAR2_IG_CCDA_MTM_CAREPLAN.xml" />
            <x:expect label="B2a. no PhCP profile anywhere in the bundle" test="count(//fhir:profile[contains(@value, '/us/phcp/')]) = 0" />
        </x:scenario>
        <x:scenario label="B3. a Dental Data Exchange document no longer gets the Da Vinci hrex-coverage profile">
            <x:context select="//cda:act[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.61']">
                <ClinicalDocument xmlns="urn:hl7-org:v3" lcg:uuid="00000000-0000-0000-0000-0000000007a0">
                    <templateId root="2.16.840.1.113883.10.20.40.1.1.2" />
                    <component><structuredBody><component><section>
                        <code code="48768-6" codeSystem="2.16.840.1.113883.6.1" />
                        <entry><act classCode="ACT" moodCode="EVN">
                            <templateId root="2.16.840.1.113883.10.20.22.4.60" extension="2015-08-01" />
                            <entryRelationship typeCode="COMP">
                                <act classCode="ACT" moodCode="EVN" lcg:uuid="00000000-0000-0000-0000-0000000007a1">
                                    <templateId root="2.16.840.1.113883.10.20.22.4.61" extension="2015-08-01" />
                                    <id root="50000000-0000-0000-0000-000000000009" />
                                    <code code="SELF" codeSystem="2.16.840.1.113883.5.111" /><statusCode code="completed" />
                                </act>
                            </entryRelationship>
                        </act></entry>
                    </section></component></structuredBody></component>
                </ClinicalDocument>
            </x:context>
            <x:expect label="B3a. the Coverage is created" test="count(fhir:Coverage) = 1" />
            <x:expect label="B3b. it claims no profile" test="count(fhir:Coverage/fhir:meta/fhir:profile) = 0" />
        </x:scenario>
    </x:scenario>

</x:description>
