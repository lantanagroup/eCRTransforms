<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" xmlns:lcg="http://www.lantanagroup.com" stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">

    <!-- Coverage - create bundle entry-->
    <x:scenario label="A. Scenario for testing template 'cda:act[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.60'][@moodCode = 'EVN']' and mode 'bundle-entry'">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_CDAR2_IG_CCDA_MTM_CAREPLAN.xml" />

        <x:expect label="A1. There should be one Coverages resource" test="count(//fhir:entry/fhir:resource/fhir:Coverage) = 1" />
    </x:scenario>

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the
         corrected behavior and fails against the pre-fix code -->

    <x:scenario label="Policy Activity statusCode cancelled maps Coverage.status to cancelled (was hard-coded active)">
        <x:context>
            <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.61"/><id root="50000000-0000-0000-0000-000000000001"/>
            <code code="SELF" codeSystem="2.16.840.1.113883.5.111"/><statusCode code="cancelled"/>
            <performer typeCode="PRF"><templateId root="2.16.840.1.113883.10.20.22.4.87"/>
            <assignedEntity><id root="50000000-0000-0000-0000-000000000002"/>
            <code code="PAYOR" codeSystem="2.16.840.1.113883.5.110"/></assignedEntity></performer>
            <participant typeCode="COV"><participantRole classCode="PAT">
            <id root="50000000-0000-0000-0000-000000000003" extension="MEM12345"/>
            <code code="SELF" codeSystem="2.16.840.1.113883.5.111"/></participantRole></participant></act>
        </x:context>
        <x:expect label="status should be 'cancelled'"
            test="count(fhir:Coverage/fhir:status[@value = 'cancelled']) = 1" />
    </x:scenario>

</x:description>
