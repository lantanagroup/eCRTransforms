<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" xmlns:lcg="http://www.lantanagroup.com" stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">

    <x:scenario label="A. Scenario for testing Device">

        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_eICR-CDA-001_R3_1.xml" />

        <x:expect label="A1. There should be one Device with modelNumber 'Acme'" test="count(//fhir:Device/fhir:modelNumber[@value='Acme']) = 1" />
        <x:expect label="A2. There should be one Device with version 'Acme EHR'" test="count(//fhir:Device/fhir:version/fhir:value[@value='Acme EHR']) = 1" />
        <x:expect label="A3. There should be one Device with a location reference" test="count(//fhir:Device/fhir:location/fhir:reference) = 1" />
    </x:scenario>

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the
         corrected behavior and fails against the pre-fix code -->

    <x:scenario label="Product Instance participantRole (4.37) produces a Device, not a PractitionerRole">
        <x:context>
            <participantRole classCode="MANU" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.37"/>
            <id root="90000000-0000-0000-0000-000000000001"/>
            <playingDevice><code code="704708004" codeSystem="2.16.840.1.113883.6.96" displayName="Cardiac pacemaker"/></playingDevice>
            <scopingEntity><id root="90000000-0000-0000-0000-000000000002"/></scopingEntity></participantRole>
        </x:context>
        <x:expect label="Should produce a Device (template was ambiguous with PractitionerRole's generic participantRole match; include order made PractitionerRole win)"
            test="count(fhir:Device) = 1" />
        <x:expect label="Must NOT produce a PractitionerRole"
            test="count(fhir:PractitionerRole) = 0" />
    </x:scenario>

</x:description>
