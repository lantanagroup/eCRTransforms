<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Family History Organizer statusCode active maps status to partial">
        <x:context>
            <organizer classCode="CLUSTER" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.45"/><id root="f1000000-0000-0000-0000-000000000001"/>
            <statusCode code="active"/>
            <subject><relatedSubject classCode="PRS"><code code="MTH" codeSystem="2.16.840.1.113883.5.111"/>
            <subject><administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1"/><birthTime value="19500101"/></subject>
            </relatedSubject></subject>
            <component><observation classCode="OBS" moodCode="EVN">
            <templateId root="2.16.840.1.113883.10.20.22.4.46"/><id root="f1000000-0000-0000-0000-000000000002"/>
            <code code="64572001" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="completed"/>
            <value xsi:type="CD" code="38341003" codeSystem="2.16.840.1.113883.6.96" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
            </observation></component></organizer>
        </x:context>
        <x:expect label="Should produce a FamilyMemberHistory"
            test="count(fhir:FamilyMemberHistory) = 1" />
        <x:expect label="status should be 'partial', not the raw ActStatus 'active'"
            test="count(fhir:FamilyMemberHistory/fhir:status[@value = 'partial']) = 1" />
    </x:scenario>

    <x:scenario label="Family History Organizer statusCode nullified maps status to entered-in-error">
        <x:context>
            <organizer classCode="CLUSTER" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.45"/><id root="f2000000-0000-0000-0000-000000000001"/>
            <statusCode code="nullified"/>
            <subject><relatedSubject classCode="PRS"><code code="MTH" codeSystem="2.16.840.1.113883.5.111"/></relatedSubject></subject>
            </organizer>
        </x:context>
        <x:expect label="status should be 'entered-in-error'"
            test="count(fhir:FamilyMemberHistory/fhir:status[@value = 'entered-in-error']) = 1" />
    </x:scenario>

    <x:scenario label="Family History Organizer statusCode completed maps status to completed">
        <x:context>
            <organizer classCode="CLUSTER" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.45"/><id root="f3000000-0000-0000-0000-000000000001"/>
            <statusCode code="completed"/>
            <subject><relatedSubject classCode="PRS"><code code="MTH" codeSystem="2.16.840.1.113883.5.111"/></relatedSubject></subject>
            </organizer>
        </x:context>
        <x:expect label="status should be 'completed'"
            test="count(fhir:FamilyMemberHistory/fhir:status[@value = 'completed']) = 1" />
    </x:scenario>

</x:description>
