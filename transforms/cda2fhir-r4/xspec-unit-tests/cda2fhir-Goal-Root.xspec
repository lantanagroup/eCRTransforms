<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Goal Observation statusCode active maps lifecycleStatus to active">
        <x:context>
            <observation classCode="OBS" moodCode="GOL" xmlns="urn:hl7-org:v3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <templateId root="2.16.840.1.113883.10.20.22.4.121"/><id root="b1000000-0000-0000-0000-000000000001"/>
            <code code="58144-7" codeSystem="2.16.840.1.113883.6.1"/><statusCode code="active"/>
            <effectiveTime><low value="20240101"/></effectiveTime></observation>
        </x:context>
        <x:expect label="Should produce a Goal"
            test="count(fhir:Goal) = 1" />
        <x:expect label="lifecycleStatus should be 'active' (mapped, not raw ActStatus copy)"
            test="count(fhir:Goal/fhir:lifecycleStatus[@value = 'active']) = 1" />
    </x:scenario>

    <x:scenario label="Goal Observation statusCode suspended maps lifecycleStatus to on-hold">
        <x:context>
            <observation classCode="OBS" moodCode="GOL" xmlns="urn:hl7-org:v3" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
            <templateId root="2.16.840.1.113883.10.20.22.4.121"/><id root="b2000000-0000-0000-0000-000000000001"/>
            <code code="58144-7" codeSystem="2.16.840.1.113883.6.1"/><statusCode code="suspended"/>
            <effectiveTime><low value="20240101"/></effectiveTime></observation>
        </x:context>
        <x:expect label="lifecycleStatus should be 'on-hold' (raw 'suspended' is not in the Goal lifecycle value set)"
            test="count(fhir:Goal/fhir:lifecycleStatus[@value = 'on-hold']) = 1" />
    </x:scenario>

</x:description>
