<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" stylesheet="../NativeUUIDGen-cda2fhir.xslt" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:lcg="http://www.lantanagroup.com" run-as="external">

    <x:scenario label="A. Scenario for testing template with match 'cda:substanceAdministration[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.16'][@moodCode = 'EVN'][ancestor::*/cda:templateId[@root = '2.16.840.1.113883.10.20.22.2.38']]' and mode 'bundle-entry'">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_eICR-CDA-001_R3_1.xml" />

        <x:expect label="A1. There should be an entry.resource.MedicationAdministration" test="count(//fhir:entry/fhir:resource/fhir:MedicationAdministration)=1" />
    </x:scenario>

    <x:scenario label="B. Scenario for testing template with match 'cda:substanceAdministration[cda:templateId/@root = '2.16.840.1.113883.10.20.22.4.16'][@moodCode = 'EVN'][ancestor::*/cda:templateId[@root = '2.16.840.1.113883.10.20.22.2.38']]">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_eICR-CDA-001_R3_1.xml" />
        
        <x:expect label="B1. There should be a MedicationAdministration" test="count(//fhir:MedicationAdministration)=1" />
        <x:expect label="B2. There should be a status='completed'" test="count(//fhir:MedicationAdministration/fhir:status[@value='completed'])=1" />
        <x:expect label="B3.1. There should be a MedicationAdministration.medicationReference"
            test="count(//fhir:MedicationAdministration/fhir:medicationReference)=1" />
        
        <x:expect label="B3.2. There should be a Medication.code.coding.system.value=http://www.nlm.nih.gov/research/umls/rxnorm"
            test="count(//fhir:Medication/fhir:code/fhir:coding/fhir:system[@value='http://www.nlm.nih.gov/research/umls/rxnorm'])=1" />
        <x:expect label="B4. There should be a Medication.code.coding.code.value=248656"
            test="count(//fhir:Medication/fhir:code/fhir:coding/fhir:code[@value='248656'])=1" />
        <x:expect label="B5. There should be a Medication.code.coding.display.value=Azithromycin 500 MG Oral Tablet"
            test="count(//fhir:Medication/fhir:code/fhir:coding/fhir:display[@value='Azithromycin 500 MG Oral Tablet'])=1" />
        <x:expect label="B6. There should be an MedicationAdministration.subject.reference.value=urn:uuid:" test="count(//fhir:MedicationAdministration/fhir:subject/fhir:reference[starts-with(@value, 'urn:uuid:')])=1" />
        <!-- SG: Updating this because it looks like because the TZ hasn't been specified it puts in whatever timezone is set on your PC - it put +10:00 for me 
          I feel like it shouldn't add a TZ if there isn't one there but that's how RG originally wrote it so leaving for now-->
        <x:expect label="B7. There should be a effectiveDateTime.value where the first 19 chars are: '2020-11-07T11:15:00' (ingoring TZ)"
            test="count(//fhir:MedicationAdministration/fhir:effectiveDateTime[substring(@value, 1,19) ='2020-11-07T11:15:00'])=1" />
        <x:expect label="B8. There should be a dosage.route.coding.system.value=http://ncimeta.nci.nih.gov"
            test="count(//fhir:MedicationAdministration/fhir:dosage/fhir:route/fhir:coding/fhir:system[@value='http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl'])=1" />
        <x:expect label="B9. There should be a dosage.route.coding.code.value=C38288" test="count(//fhir:MedicationAdministration/fhir:dosage/fhir:route/fhir:coding/fhir:code[@value='C38288'])=1" />
        <x:expect label="B10. There should be a dosage.route.coding.display.value=ORAL" test="count(//fhir:MedicationAdministration/fhir:dosage/fhir:route/fhir:coding/fhir:display[@value='ORAL'])=1" />
        <x:expect label="B11. There should be a dose with value = '1' and unit = 'g'" test="count(//fhir:MedicationAdministration/fhir:dosage/fhir:dose[fhir:value/@value='1'][fhir:unit/@value='g'])=1" />
    </x:scenario>
    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-C6): the administration time is chosen by
         shape, not by position. Whole-pipeline test on integration-tests/documents/testMedTime.xml. -->
    <x:scenario label="T. administration time is found whichever effectiveTime comes first (RT-C6)">
        <x:context href="../../integration-tests/documents/testMedTime.xml" />
        <x:expect label="T1. frequency first, interval second: effectivePeriod from the interval"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-FIRST']/fhir:effectivePeriod/fhir:start/@value = '2026-07-20' and //fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-FIRST']/fhir:effectivePeriod/fhir:end/@value = '2026-07-25'" />
        <x:expect label="T2. event-based frequency first, point in time second: effectiveDateTime"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-EVENT-FIRST']/fhir:effectiveDateTime/@value = '2026-07-21'" />
        <x:expect label="T3. same in the Admission Medications section template"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-ADM-FREQ-FIRST']/fhir:effectivePeriod/fhir:start/@value = '2026-07-20'" />
        <x:expect label="T4. control: interval first, frequency second is unchanged"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-LAST']/fhir:effectivePeriod/fhir:end/@value = '2026-07-25'" />
        <x:expect label="T5. control: a frequency that carries a value and stands alone still gives effectiveDateTime"
            test="starts-with(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-VALUE-ONLY']/fhir:effectiveDateTime/@value, '2026-07-22T11:59')" />
        <x:expect label="T6. never more than one effective[x]"
            test="every $m in //fhir:MedicationAdministration satisfies count($m/fhir:*[starts-with(local-name(), 'effective')]) le 1" />
    </x:scenario>
    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-B16): a Therapeutic Medication Response with no
         value gave an empty extension. The extension is now written only when there is a value. (Its date, id
         and status are not carried, and it is carried only on an administered medication: SG confirmed.) -->
    <x:scenario label="U. therapeutic medication response extension only when it has a value (RT-B16)">
        <x:context href="../../integration-tests/documents/testMedTime.xml" />
        <x:expect label="U1. no extension anywhere is without a value or child extension" test="empty(//fhir:extension[not(fhir:*)])" />
        <x:expect label="U2. a response with no value gives no extension" test="exists(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-FIRST']) and empty(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-FIRST']/fhir:extension[@url = 'http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-therapeutic-medication-response-extension'])" />
        <x:expect label="U3. control: a coded response is still carried"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-LAST']/fhir:extension[@url = 'http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-therapeutic-medication-response-extension']/fhir:valueCodeableConcept/fhir:coding/fhir:code/@value = '268910001'" />
        <x:expect label="U4. every extension of this kind has a valueCodeableConcept with content"
            test="every $e in //fhir:extension[@url = 'http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-therapeutic-medication-response-extension'] satisfies exists($e/fhir:valueCodeableConcept/fhir:*)" />
    </x:scenario>
    <!-- 20261125 Claude (SG decision 2026-11-25, re-trace finding RT-C4): a dose or rate quantity whose unit is on
         the transform's list of known UCUM units ($gvKnownUcumUnits in cda-to-fhir-datatypes.xslt) also gets
         Quantity.system http://unitsofmeasure.org and Quantity.code. Any other unit is carried exactly as
         before: value and unit text only. -->
    <x:scenario label="V. UCUM system and code on dose and rate quantities with a known unit (RT-C4)">
        <x:context href="../../integration-tests/documents/testMedTime.xml" />
        <x:expect label="V1. dose in mg: system and code"
            test="exists(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-LAST']/fhir:dosage/fhir:dose[fhir:value/@value = '81'][fhir:unit/@value = 'mg'][fhir:system/@value = 'http://unitsofmeasure.org'][fhir:code/@value = 'mg'])" />
        <x:expect label="V2. rate in mg/h: system and code"
            test="exists(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-LAST']/fhir:dosage/fhir:rateQuantity[fhir:unit/@value = 'mg/h'][fhir:system/@value = 'http://unitsofmeasure.org'][fhir:code/@value = 'mg/h'])" />
        <x:expect label="V3. the UCUM annotation {capsule} is on the list" test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-ADM-FREQ-FIRST']/fhir:dosage/fhir:dose[fhir:system/@value = 'http://unitsofmeasure.org']/fhir:code/@value = '{capsule}'" />
        <x:expect label="V4. control: 'Unknown' is carried as unit text only"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-EVENT-FIRST']/fhir:dosage/fhir:dose/fhir:unit/@value = 'Unknown' and empty(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-EVENT-FIRST']/fhir:dosage/fhir:dose/(fhir:system | fhir:code))" />
        <x:expect label="V5. control: 'capsule' without braces is carried as unit text only"
            test="//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-VALUE-ONLY']/fhir:dosage/fhir:dose/fhir:unit/@value = 'capsule' and empty(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-VALUE-ONLY']/fhir:dosage/fhir:dose/(fhir:system | fhir:code))" />
        <x:expect label="V6. element order inside the quantity: value, unit, system, code"
            test="string-join(//fhir:MedicationAdministration[fhir:identifier/fhir:value/@value = 'MT-FREQ-LAST']/fhir:dosage/fhir:dose/fhir:*/local-name(), ' ') = 'value unit system code'" />
    </x:scenario>
    <!-- 20261125 Claude (SG decision 2026-11-25, re-trace finding RT-C5): a Medication carried code and form only.
         manufacturerOrganization now becomes an Organization referenced from Medication.manufacturer and
         lotNumberText goes to Medication.batch.lotNumber, as Immunization already did. A Drug Vehicle participant
         (typeCode CSM) used to be written to Medication.form, which it is not, and two vehicles gave two form
         elements (max 1); each vehicle is now a Medication.ingredient. Whole-pipeline test on testMed.xml. -->
    <x:scenario label="W. Medication manufacturer, lot number and drug vehicle (RT-C5)">
        <x:context href="../../integration-tests/documents/testMed.xml" />
        <x:expect label="W1. manufacturer references an Organization entry named Acme Pharma"
            test="//fhir:entry[fhir:fullUrl/@value = //fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:manufacturer/fhir:reference/@value]/fhir:resource/fhir:Organization/fhir:name/@value = 'Acme Pharma'" />
        <x:expect label="W2. lot number" test="//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:batch/fhir:lotNumber/@value = 'LOT42'" />
        <x:expect label="W3. a coded vehicle is an ingredient with the code"
            test="//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:ingredient[1]/fhir:itemCodeableConcept/fhir:coding[fhir:system/@value = 'http://www.nlm.nih.gov/research/umls/rxnorm']/fhir:code/@value = '9863'" />
        <x:expect label="W4. a vehicle with a null-flavored code is an ingredient with the name as text"
            test="count(//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:ingredient) = 2 and //fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:ingredient[2]/fhir:itemCodeableConcept/fhir:text/@value = 'House diluent' and empty(//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:ingredient[2]/fhir:itemCodeableConcept/fhir:coding)" />
        <x:expect label="W5. no Medication has form" test="exists(//fhir:Medication) and empty(//fhir:Medication/fhir:form)" />
        <x:expect label="W6. element order: code, manufacturer, ingredient, batch"
            test="string-join(distinct-values(//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '1191']/fhir:*[not(self::fhir:meta)]/local-name()), ' ') = 'code manufacturer ingredient batch'" />
        <x:expect label="W7. control: null-flavored lot number and manufacturer give nothing"
            test="exists(//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '161']) and empty(//fhir:Medication[fhir:code/fhir:coding/fhir:code/@value = '161']/(fhir:manufacturer | fhir:batch | fhir:ingredient))" />
        <x:expect label="W8. every reference in the bundle resolves" test="every $r in //fhir:reference/@value[starts-with(., 'urn:uuid:')] satisfies exists(//fhir:entry[fhir:fullUrl/@value = $r])" />
    </x:scenario>
</x:description>
