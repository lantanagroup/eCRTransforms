<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Medication Dispense (4.18) statusCode active maps status to in-progress (status was omitted entirely)">
        <x:context>
            <supply classCode="SPLY" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.18"/><id root="e1000000-0000-0000-0000-000000000001"/>
            <statusCode code="active"/>
            <product><manufacturedProduct classCode="MANU"><templateId root="2.16.840.1.113883.10.20.22.4.23"/>
            <manufacturedMaterial><code code="197361" codeSystem="2.16.840.1.113883.6.88"/></manufacturedMaterial>
            </manufacturedProduct></product></supply>
        </x:context>
        <x:expect label="Should produce a MedicationDispense"
            test="count(fhir:MedicationDispense) = 1" />
        <x:expect label="status is required 1..1 and must be present for non-completed/aborted codes"
            test="count(fhir:MedicationDispense/fhir:status) = 1" />
        <x:expect label="statusCode active should map to 'in-progress'"
            test="count(fhir:MedicationDispense/fhir:status[@value = 'in-progress']) = 1" />
    </x:scenario>

    <x:scenario label="Medication Dispense (4.18) statusCode completed maps status to completed">
        <x:context>
            <supply classCode="SPLY" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.18"/><id root="e2000000-0000-0000-0000-000000000001"/>
            <statusCode code="completed"/>
            <product><manufacturedProduct classCode="MANU"><templateId root="2.16.840.1.113883.10.20.22.4.23"/>
            <manufacturedMaterial><code code="197361" codeSystem="2.16.840.1.113883.6.88"/></manufacturedMaterial>
            </manufacturedProduct></product></supply>
        </x:context>
        <x:expect label="status should be 'completed'"
            test="count(fhir:MedicationDispense/fhir:status[@value = 'completed']) = 1" />
    </x:scenario>

    <!-- 20261125 Claude (SG decision 2026-11-25, re-trace finding RT-C3): a MedicationRequest is produced for moods
         INT, RQO, PRMS and PRP and always folds a nested Medication Supply Order (22.4.17) into dispenseRequest, but
         the rule that stops the same supply also becoming a MedicationDispense recognised INT only. Under RQO, PRMS
         or PRP the supply was carried twice. All those tests now use the same four moods.
         Whole-pipeline test on testMed.xml. -->
    <x:scenario label="RT-C3. a supply order under a medication request is carried once, in dispenseRequest">
        <x:context href="../../integration-tests/documents/testMed.xml" />
        <x:expect label="1. each planned medication has its supply in dispenseRequest (repeats allowed = repeatNumber minus the first fill)"
            test="//fhir:MedicationRequest[fhir:identifier/fhir:value/@value = 'PLAN-RQO']/fhir:dispenseRequest/fhir:numberOfRepeatsAllowed/@value = '3' and //fhir:MedicationRequest[fhir:identifier/fhir:value/@value = 'PLAN-PRMS']/fhir:dispenseRequest/fhir:numberOfRepeatsAllowed/@value = '4' and //fhir:MedicationRequest[fhir:identifier/fhir:value/@value = 'PLAN-PRP']/fhir:dispenseRequest/fhir:numberOfRepeatsAllowed/@value = '5'" />
        <x:expect label="2. no supply order is also a MedicationDispense"
            test="empty(//fhir:MedicationDispense[fhir:identifier/fhir:value/@value = ('SUPPLY-RQO', 'SUPPLY-PRMS', 'SUPPLY-PRP')])" />
        <x:expect label="3. the only MedicationDispense resources are the real dispenses"
            test="count(//fhir:MedicationDispense) = 2" />
        <x:expect label="4. a real dispense under an RQO request points at its MedicationRequest"
            test="//fhir:MedicationDispense[fhir:identifier/fhir:value/@value = 'DISPENSED-RQO']/fhir:authorizingPrescription/fhir:reference/@value = //fhir:entry[fhir:resource/fhir:MedicationRequest/fhir:identifier/fhir:value/@value = 'PLAN-RQO']/fhir:fullUrl/@value" />
        <x:expect label="5. no section entry references a supply order" test="every $r in //fhir:Composition/fhir:section/fhir:entry/fhir:reference/@value satisfies exists(//fhir:entry[fhir:fullUrl/@value = $r])" />
        <x:expect label="6. every reference in the bundle resolves" test="every $r in //fhir:reference/@value[starts-with(., 'urn:uuid:')] satisfies exists(//fhir:entry[fhir:fullUrl/@value = $r])" />
        <x:expect label="7. control: the INT medication still has its dispenseRequest" test="count(//fhir:MedicationRequest/fhir:dispenseRequest) = 4" />
    </x:scenario>

</x:description>
