<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Medication Dispense (4.18) statusCode active maps status to in-progress (status was omitted entirely)">
        <x:context>
            <supply classCode="SPLY" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.18"/><id root="e1000000-0000-0000-0000-000000000001"/>
            <statusCode code="active"/>
            <product><manufacturedProduct classCode="MANU"><templateId root="2.16.840.1.113883.10.20.22.4.23"/>
            <manufacturedMaterial><code code="197361" codeSystem="2.16.840.1.113883.6.88"/></manufacturedMaterial>
            </manufacturedProduct></product></supply>
        </x:context>
        <x:expect label="Should produce a MedicationDispense"
            test="count(fhir:MedicationDispense) = 1" />
        <x:expect label="status is required 1..1 and must be present for non-completed/aborted codes"
            test="count(fhir:MedicationDispense/fhir:status) = 1" />
        <x:expect label="statusCode active should map to 'in-progress'"
            test="count(fhir:MedicationDispense/fhir:status[@value = 'in-progress']) = 1" />
    </x:scenario>

    <x:scenario label="Medication Dispense (4.18) statusCode completed maps status to completed">
        <x:context>
            <supply classCode="SPLY" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.18"/><id root="e2000000-0000-0000-0000-000000000001"/>
            <statusCode code="completed"/>
            <product><manufacturedProduct classCode="MANU"><templateId root="2.16.840.1.113883.10.20.22.4.23"/>
            <manufacturedMaterial><code code="197361" codeSystem="2.16.840.1.113883.6.88"/></manufacturedMaterial>
            </manufacturedProduct></product></supply>
        </x:context>
        <x:expect label="status should be 'completed'"
            test="count(fhir:MedicationDispense/fhir:status[@value = 'completed']) = 1" />
    </x:scenario>

</x:description>
