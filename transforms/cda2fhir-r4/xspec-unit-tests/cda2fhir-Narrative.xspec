<?xml version="1.0" encoding="UTF-8"?>
<!-- 20260730 Claude: stylesheet repointed from ../cda2fhir-Narrative.xslt (a module, not an entry point - it
     references $gvCurrentIg, which is declared in c-to-fhir-utility.xslt and out of scope when the module is
     compiled alone, so this file could never run) to ../NativeUUIDGen-cda2fhir.xslt, the same free-Saxon entry
     point the rest of the suite uses. CDAtext and the whole include chain are in scope through it. -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" stylesheet="../NativeUUIDGen-cda2fhir.xslt" xmlns:lcg="http://www.lantanagroup.com" xmlns="urn:hl7-org:v3" xmlns:n1="urn:hl7-org:v3"
    xmlns:in="urn:lantana-com:inline-variable-data" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:xhtml="http://www.w3.org/1999/xhtml" run-as="external">

    <x:scenario label="Scenario for testing function CDAtext">
        <x:context href="../../../samples/cda/RR-R1/RR-CDA-001_R1.xml" />

        <x:call template="CDAtext" />
        <x:expect label="Should produce a table" test="count(xhtml:table) = 1" />

    </x:scenario>

</x:description>
