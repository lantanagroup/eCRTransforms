    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-B2): the profile lookup wrote one
         <profile> per templateId that has a key, so a conformant STU 3.1.1 Pregnancy Observation, which
         carries both 15.3.8 and 22.4.293:2018-04-01 (both mapped to us-ph-pregnancy-status-observation),
         listed the same profile twice. Each profile is now written once; the comment naming each
         contributing templateId is kept. -->
    <x:scenario label="N. a profile reached through two templateIds is listed once (RT-B2)">
        <x:scenario label="N1. Pregnancy Observation with 15.3.8 and 22.4.293:2018-04-01">
            <x:context select="//cda:observation">
                <ClinicalDocument xmlns="urn:hl7-org:v3" lcg:uuid="00000000-0000-0000-0000-000000000ba0">
                    <templateId root="2.16.840.1.113883.10.20.15.2" extension="2022-05-01" />
                    <component><structuredBody><component><section>
                        <code code="90767-5" codeSystem="2.16.840.1.113883.6.1" />
                        <entry>
                            <observation classCode="OBS" moodCode="EVN" lcg:uuid="00000000-0000-0000-0000-000000000ba1">
                                <templateId root="2.16.840.1.113883.10.20.15.3.8" />
                                <templateId root="2.16.840.1.113883.10.20.22.4.293" extension="2018-04-01" />
                                <id root="2.16.840.1.113883.19.5" extension="PREG-1" />
                                <code code="ASSERTION" codeSystem="2.16.840.1.113883.5.4" />
                                <statusCode code="completed" />
                                <effectiveTime><low value="20201101" /></effectiveTime>
                                <value xsi:type="CD" code="77386006" codeSystem="2.16.840.1.113883.6.96" displayName="Pregnant" />
                            </observation>
                        </entry>
                    </section></component></structuredBody></component>
                </ClinicalDocument>
            </x:context>
            <x:expect label="N1a. exactly one meta.profile" test="count(fhir:Observation/fhir:meta/fhir:profile) = 1" />
            <x:expect label="N1b. it is us-ph-pregnancy-status-observation" test="fhir:Observation/fhir:meta/fhir:profile/@value = 'http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-pregnancy-status-observation'" />
            <x:expect label="N1c. control: both templateIds are still named in comments" test="count(fhir:Observation/fhir:meta/comment()[contains(., 'CDA templateId')]) = 2" />
        </x:scenario>
        <x:scenario label="N2. no resource in the RR fixture lists a profile twice">
            <x:context href="../../integration-tests/documents/testRR.xml" />
            <x:expect label="N2a. no duplicate profile in any meta" test="every $m in //fhir:meta satisfies count($m/fhir:profile/@value) = count(distinct-values($m/fhir:profile/@value))" />
        </x:scenario>
    </x:scenario>
    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-B17): Result Observation / Vital Sign
         values. (1) Types that matched no template and so produced no value at all are now carried: CO and
         CV as valueCodeableConcept, RTO_* as valueRatio, IVL_INT as valueRange. (2) A value that is ONLY a
         nullFlavor (no code, value, text or child content) becomes Observation.dataAbsentReason; before, a
         null PQ/REAL gave nothing (us-core-2 error), a null ST gave valueString holding the nullFlavor code,
         and a null CD gave a valueCodeableConcept whose coding held only a data-absent-reason. A
         null-flavored value that still carries content (originalText, translation) is handled as before.
         (3) A value with no xsi:type and text content becomes valueString; before, the text leaked loose
         into the Observation element. -->
