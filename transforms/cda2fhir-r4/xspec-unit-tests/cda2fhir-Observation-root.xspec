                                    <value xsi:type="CO" code="LA6576-8" codeSystem="2.16.840.1.113883.6.1" displayName="Positive" />
                                </observation>
                            </component>
                        </organizer></entry>
                    </section></component></structuredBody></component>
                </ClinicalDocument>
            </x:context>
            <x:expect label="O1a. valueCodeableConcept with the code" test="fhir:Observation/fhir:valueCodeableConcept/fhir:coding/fhir:code/@value = 'LA6576-8'" />
