<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" stylesheet="../NativeUUIDGen-cda2fhir.xslt" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:lcg="http://www.lantanagroup.com" run-as="external">

    <!-- All Patients - Create bundle entry -->
    <x:scenario label="Scenario for testing template 'cda:recordTarget'">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_RR-CDA-001_R1_1.xml" />
        <x:expect label="There should be an entry.resource.Patient" test="count(/fhir:Bundle/fhir:entry/fhir:resource/fhir:Patient)=1" />
    </x:scenario>

    <!-- RR Patient - Create resource -->
    <x:scenario label="Scenario for testing template with patient extensions">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_RR-CDA-001_R1_1.xml" />

        <x:expect label="There should be one Patient" test="count(//fhir:Patient)=1" />
        <x:expect label="There should be an eCR Patient meta.profile" test="count(//fhir:Patient/fhir:meta/fhir:profile[@value='http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-patient'])=1" />
        <x:expect label="There should be a us-core-race extension" test="count(//fhir:Patient/fhir:extension[@url='http://hl7.org/fhir/us/core/StructureDefinition/us-core-race'])=1" />
        <x:expect label="There should be a us-core-ethnicity extension" test="count(//fhir:Patient/fhir:extension[@url='http://hl7.org/fhir/us/core/StructureDefinition/us-core-ethnicity'])=1" />
        <x:expect label="There should be 2 identifiers" test="count(//fhir:Patient/fhir:identifier)=2" />

        <x:expect label="There should be 2 telecoms" test="count(//fhir:Patient/fhir:telecom)=2" />
        <x:expect label="There should be 1 gender" test="count(//fhir:Patient/fhir:gender)=1" />
        <x:expect label="There should be 1 birthDate" test="count(//fhir:Patient/fhir:birthDate)=1" />
        <x:expect label="There should be 1 deceasedDateTime" test="count(//fhir:Patient/fhir:deceasedBoolean)=1" />
        <x:expect label="There should be 1 address" test="count(//fhir:Patient/fhir:address)=1" />
        <x:expect label="There should be 0 guardian" test="count(//fhir:Patient/fhir:contact/fhir:relationship/fhir:coding/fhir:code)=0" />
        <x:expect label="There should be 1 name" test="count(//fhir:Patient/fhir:name)=1" />
        <x:expect label="There should be 1 communication.language" test="count(//fhir:Patient/fhir:communication/fhir:language/fhir:coding/fhir:code)=1" />
        <x:expect label="There should be 1 communication.preferred" test="count(//fhir:Patient/fhir:communication/fhir:preferred)=1" />

    </x:scenario>

    <!-- eICR Patient - Create resource -->
    <x:scenario label="Scenario for testing template with patient extensions">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_eICR-CDA-001_R3_1.xml" />

        <x:expect label="There should be one Patient" test="count(//fhir:Patient)=1" />
        <x:expect label="There should be an eCR Patient meta.profile" test="count(//fhir:Patient/fhir:meta/fhir:profile[@value='http://hl7.org/fhir/us/ecr/StructureDefinition/us-ph-patient'])=1" />
        <x:expect label="There should be a us-core-race extension" test="count(//fhir:Patient/fhir:extension[@url='http://hl7.org/fhir/us/core/StructureDefinition/us-core-race'])=1" />
        <x:expect label="There should be a us-core-ethnicity extension" test="count(//fhir:Patient/fhir:extension[@url='http://hl7.org/fhir/us/core/StructureDefinition/us-core-ethnicity'])=1" />
        <x:expect label="There should be a patient-birthPlace extension" test="count(//fhir:Patient/fhir:extension[@url='http://hl7.org/fhir/StructureDefinition/patient-birthPlace'])=1" />
        
        <x:expect label="There should be 2 identifiers" test="count(//fhir:Patient/fhir:identifier)=2" />

        <x:expect label="There should be 2 telecoms" test="count(//fhir:Patient/fhir:telecom)=2" />
        <x:expect label="There should be 1 gender" test="count(//fhir:Patient/fhir:gender)=1" />
        <x:expect label="There should be 1 birthDate" test="count(//fhir:Patient/fhir:birthDate)=1" />
        <x:expect label="There should be 1 deceasedDateTime" test="count(//fhir:Patient/fhir:deceasedBoolean)=1" />
        <x:expect label="There should be 1 address" test="count(//fhir:Patient/fhir:address)=1" />
        <x:expect label="There should be 1 guardian" test="count(//fhir:Patient/fhir:contact/fhir:relationship/fhir:coding/fhir:code[@value='GUARD'])=1" />
        <x:expect label="There should be 2 names" test="count(//fhir:Patient/fhir:name)=2" />
        <x:expect label="There should be 1 communication.language" test="count(//fhir:Patient/fhir:communication/fhir:language/fhir:coding/fhir:code)=1" />
        <x:expect label="There should be 1 communication.preferred" test="count(//fhir:Patient/fhir:communication/fhir:preferred)=1" />
        <x:expect label="There should be 1 emergency contact" test="count(//fhir:Patient/fhir:contact/fhir:relationship/fhir:coding/fhir:code[@value='C'])=1" />
        <x:expect label="There should be 1 emergency contact name" test="count(//fhir:Patient/fhir:contact[fhir:relationship/fhir:coding/fhir:code[@value='C']]/fhir:name)=1" />
        <x:expect label="There should be 1 emergency contact address" test="count(//fhir:Patient/fhir:contact[fhir:relationship/fhir:coding/fhir:code[@value='C']]/fhir:address)=1" />
        <x:expect label="There should be 1 emergency contact telecom" test="count(//fhir:Patient/fhir:contact[fhir:relationship/fhir:coding/fhir:code[@value='C']]/fhir:telecom)=1" />

    </x:scenario>
  <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-A18): eICR Vol 2 CONF:4527-403 allows
       deceasedInd=false together with a null-flavored deceasedTime. deceasedTime was tested first, so
       that shape produced deceasedDateTime (carrying only a data-absent-reason), which in FHIR says the
       patient HAS died, and the explicit false was lost. It now gives deceasedBoolean false. Every
       other shape is unchanged, including deceasedInd=true with a null-flavored time (kept as
       deceasedDateTime with the reason, e.g. masked for MSK). -->
  <x:scenario label="P. deceasedInd and deceasedTime (RT-A18)">
    <x:scenario label="P1. deceasedInd false with deceasedTime nullFlavor NA">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedInd value="false" />
                <sdtc:deceasedTime nullFlavor="NA" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P1a. deceasedBoolean false" test="fhir:Patient/fhir:deceasedBoolean/@value = 'false'" />
      <x:expect label="P1b. no deceasedDateTime" test="count(fhir:Patient/fhir:deceasedDateTime) = 0" />
      <x:expect label="P1c. exactly one deceased[x]" test="count(fhir:Patient/*[starts-with(local-name(), 'deceased')]) = 1" />
    </x:scenario>
    <x:scenario label="P2. deceasedInd false with deceasedTime nullFlavor UNK">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedInd value="false" />
                <sdtc:deceasedTime nullFlavor="UNK" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P2a. deceasedBoolean false, no deceasedDateTime" test="fhir:Patient/fhir:deceasedBoolean/@value = 'false' and count(fhir:Patient/fhir:deceasedDateTime) = 0" />
    </x:scenario>
    <x:scenario label="P3. control: deceasedInd true with deceasedTime nullFlavor MSK keeps deceasedDateTime with the reason">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedInd value="true" />
                <sdtc:deceasedTime nullFlavor="MSK" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P3a. deceasedDateTime with data-absent-reason masked" test="fhir:Patient/fhir:deceasedDateTime/fhir:extension[@url = 'http://hl7.org/fhir/StructureDefinition/data-absent-reason']/fhir:valueCode/@value = 'masked'" />
      <x:expect label="P3b. no deceasedBoolean" test="count(fhir:Patient/fhir:deceasedBoolean) = 0" />
    </x:scenario>
    <x:scenario label="P4. control: deceasedInd true with a valued deceasedTime">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedInd value="true" />
                <sdtc:deceasedTime value="20260726" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P4a. deceasedDateTime carries the date" test="fhir:Patient/fhir:deceasedDateTime/@value = '2026-07-26' and count(fhir:Patient/fhir:deceasedBoolean) = 0" />
    </x:scenario>
    <x:scenario label="P5. control: deceasedInd false alone">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedInd value="false" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P5a. deceasedBoolean false" test="fhir:Patient/fhir:deceasedBoolean/@value = 'false' and count(fhir:Patient/fhir:deceasedDateTime) = 0" />
    </x:scenario>
    <x:scenario label="P6. control: null-flavored deceasedTime with no deceasedInd keeps deceasedDateTime with the reason">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004a0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004a1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="19800101" />
                <sdtc:deceasedTime nullFlavor="UNK" />
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="P6a. deceasedDateTime with data-absent-reason unknown" test="fhir:Patient/fhir:deceasedDateTime/fhir:extension[@url = 'http://hl7.org/fhir/StructureDefinition/data-absent-reason']/fhir:valueCode/@value = 'unknown' and count(fhir:Patient/fhir:deceasedBoolean) = 0" />
    </x:scenario>
  </x:scenario>
  <!-- 20261125 Claude (SG decision 2026-11-25, re-trace finding RT-A19): guardian/code (mother, father,
       power of attorney and so on) was never read. It is now a second coding in the SAME relationship
       CodeableConcept, after the fixed GUARD coding: us-ph-patient makes contact.relationship 1..1, so a
       second relationship element is not allowed. A null-flavored or absent code adds nothing. -->
  <x:scenario label="Q. guardian/code as a second relationship coding (RT-A19)">
    <x:scenario label="Q1. guardian with code MTH">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004c0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004c1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="20200101" />
                <guardian>
                  <code code="MTH" codeSystem="2.16.840.1.113883.5.111" displayName="mother" />
                  <addr><streetAddressLine>1 Main St</streetAddressLine><city>Town</city><state>IL</state><postalCode>61707</postalCode></addr>
                  <telecom value="tel:+1-555-555-0100" use="HP" />
                  <guardianPerson><name><given>Gua</given><family>Rdian</family></name></guardianPerson>
                </guardian>
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="Q1a. one contact with exactly one relationship" test="count(fhir:Patient/fhir:contact) = 1 and count(fhir:Patient/fhir:contact/fhir:relationship) = 1" />
      <x:expect label="Q1b. GUARD is the first coding" test="fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[1]/fhir:code/@value = 'GUARD' and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[1]/fhir:system/@value = 'http://terminology.hl7.org/CodeSystem/v3-RoleClass'" />
      <x:expect label="Q1c. the source code is the second coding" test="count(fhir:Patient/fhir:contact/fhir:relationship/fhir:coding) = 2 and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[2]/fhir:system/@value = 'http://terminology.hl7.org/CodeSystem/v3-RoleCode' and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[2]/fhir:code/@value = 'MTH' and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[2]/fhir:display/@value = 'mother'" />
      <x:expect label="Q1d. name, telecom and address still follow" test="exists(fhir:Patient/fhir:contact/fhir:relationship/following-sibling::fhir:name) and exists(fhir:Patient/fhir:contact/fhir:relationship/following-sibling::fhir:telecom) and exists(fhir:Patient/fhir:contact/fhir:relationship/following-sibling::fhir:address)" />
    </x:scenario>
    <x:scenario label="Q2. control: guardian with no code">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004c0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004c1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="20200101" />
                <guardian>
                  
                  <addr><streetAddressLine>1 Main St</streetAddressLine><city>Town</city><state>IL</state><postalCode>61707</postalCode></addr>
                  <telecom value="tel:+1-555-555-0100" use="HP" />
                  <guardianPerson><name><given>Gua</given><family>Rdian</family></name></guardianPerson>
                </guardian>
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="Q2a. GUARD only" test="count(fhir:Patient/fhir:contact/fhir:relationship) = 1 and count(fhir:Patient/fhir:contact/fhir:relationship/fhir:coding) = 1 and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding/fhir:code/@value = 'GUARD' and count(fhir:Patient/fhir:contact/fhir:relationship/*) = 1" />
    </x:scenario>
    <x:scenario label="Q3. control: null-flavored code">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004c0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004c1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="20200101" />
                <guardian>
                  <code nullFlavor="NI" />
                  <addr><streetAddressLine>1 Main St</streetAddressLine><city>Town</city><state>IL</state><postalCode>61707</postalCode></addr>
                  <telecom value="tel:+1-555-555-0100" use="HP" />
                  <guardianPerson><name><given>Gua</given><family>Rdian</family></name></guardianPerson>
                </guardian>
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="Q3a. GUARD only, nothing else in relationship" test="count(fhir:Patient/fhir:contact/fhir:relationship) = 1 and count(fhir:Patient/fhir:contact/fhir:relationship/fhir:coding) = 1 and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding/fhir:code/@value = 'GUARD' and count(fhir:Patient/fhir:contact/fhir:relationship/*) = 1 and empty(fhir:Patient/fhir:contact/fhir:relationship//fhir:extension)" />
    </x:scenario>
    <x:scenario label="Q4. code with a translation and original text">
      <x:context select="//cda:recordTarget">
        <ClinicalDocument xmlns="urn:hl7-org:v3" xmlns:sdtc="urn:hl7-org:sdtc" lcg:uuid="00000000-0000-0000-0000-0000000004c0">
          <templateId root="2.16.840.1.113883.10.20.15.2" />
          <recordTarget lcg:uuid="00000000-0000-0000-0000-0000000004c1">
            <patientRole>
              <id root="2.16.840.1.113883.19.5" extension="MRN-1" />
              <patient>
                <name><given>Pat</given><family>Ient</family></name>
                <administrativeGenderCode code="F" codeSystem="2.16.840.1.113883.5.1" />
                <birthTime value="20200101" />
                <guardian>
                  <code code="MTH" codeSystem="2.16.840.1.113883.5.111" displayName="mother"><originalText>Mum</originalText><translation code="72705000" codeSystem="2.16.840.1.113883.6.96" displayName="Mother" /></code>
                  <addr><streetAddressLine>1 Main St</streetAddressLine><city>Town</city><state>IL</state><postalCode>61707</postalCode></addr>
                  <telecom value="tel:+1-555-555-0100" use="HP" />
                  <guardianPerson><name><given>Gua</given><family>Rdian</family></name></guardianPerson>
                </guardian>
              </patient>
            </patientRole>
          </recordTarget>
        </ClinicalDocument>
      </x:context>
      <x:expect label="Q4a. three codings, GUARD first" test="count(fhir:Patient/fhir:contact/fhir:relationship/fhir:coding) = 3 and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[1]/fhir:code/@value = 'GUARD' and fhir:Patient/fhir:contact/fhir:relationship/fhir:coding[3]/fhir:code/@value = '72705000'" />
      <x:expect label="Q4b. original text is kept after the codings" test="fhir:Patient/fhir:contact/fhir:relationship/fhir:text/@value = 'Mum' and empty(fhir:Patient/fhir:contact/fhir:relationship/fhir:text/following-sibling::*)" />
    </x:scenario>
  </x:scenario>
</x:description>
