<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" 
    xmlns:lcg="http://www.lantanagroup.com" stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">
    
    <!-- Validate the Practitioner (cda:author) Elements -->
  <x:scenario
        label="Scenario for testing template with match 'cda:author'">
      <x:context href="../../../samples/cda/eICR-R3/eICR-CDA-001_R3.xml" />
      <!-- 20260803 Claude (item 41): 2 -> 3. This document contains a hollow assignedAuthor whose only
           id is nullFlavor; its uuid used to be blanked by the update-referenced-actor-uuids phase and
           no resource was created. Unmatched hollow authors now produce an identifier-only Practitioner
           (identifier + name both data-absent-reason here), which adds one identifier/system. -->
      <x:expect label="SHOULD contain zero or one [0..1] @extension (CONF:1198-32885)"
          test="count(//fhir:Practitioner/fhir:identifier/fhir:system) = 3" />
      <x:expect label="SHALL contain exactly one [1..1] @root='2.16.840.1.113883.4.6' National Provider Identifier (CONF:1198-32884)" 
          test="count(//fhir:Practitioner/fhir:identifier[fhir:system/@value='urn:ietf:rfc:3986'][fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']) = 1" />
      
      <!-- Validate the Practitioner (Author) Address -->
      <x:expect label="This assignedAuthor SHALL contain at least one [1..*]  US Realm Address (CONF:1198-5452)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address) = 1" />
      <x:expect label="SHALL contain at least one and not more than 4 streetAddressLine (CONF:81-7291)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address/fhir:line) =1" />
      <x:expect label="SHALL contain exactly one [1..1] city (CONF:81-7292)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address/fhir:city) =1" />
      <x:expect label="SHOULD contain zero or one [0..1] state  (CONF:81-7293)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address/fhir:state) =1" />
      <x:expect label="SHOULD contain zero or one [0..1] postalCode (CONF:81-7294)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address/fhir:postalCode) =1" />
      <x:expect label="SHOULD contain zero or one [0..1] country (CONF:81-7295)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:address/fhir:country) =1" />
      <!-- Validate the Practitioner (Author) Telecom-->
      <x:expect label="This assignedAuthor SHALL contain at least one [1..*] telecom (CONF:1198-5428)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:telecom) = 1" />
      <x:expect label="Such telecoms SHOULD contain zero or one [0..1] @use (CONF:1198-7995)" 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:telecom/fhir:use) = 1" />
      <!-- Validate the Practitioner (Author) Name-->
      <x:expect label="This assignedAuthor SHOULD contain zero or one [0..1] assignedPerson (CONF:1198-5430)." 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:name) = 1" />
      <x:expect label="The assignedPerson, if present, SHALL contain at least one [1..*] US Realm Person Name (surname)  (CONF:1198-16789)." 
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:name/fhir:family) = 1" />
      <x:expect label="The assignedPerson, if present, SHALL contain at least one [1..*] US Realm Person Name (firstname)  (CONF:1198-16789)."
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value='urn:uuid:ec399842-7c0d-4cfc-ada3-f11a799d0460']/fhir:name/fhir:given) = 1" />
  </x:scenario>

    <!-- 20260803 Claude (item 41): an unmatched hollow author (flagged lcg:unmatched="true" by the
         update-referenced-actor-uuids phase) becomes an identifier-only Practitioner so the ids the
         document carries (typically an NPI) are preserved and requester / Provenance.agent.who
         references resolve. Before this template existed the author's uuid was blanked and downstream
         references were emitted as the invalid "urn:uuid:". -->
    <x:scenario label="Unmatched hollow assignedAuthor becomes an identifier-only Practitioner with a data-absent-reason family">
        <x:context select="//cda:assignedAuthor">
            <cda:author lcg:uuid="00000000-0000-0000-0000-00000000000a">
                <cda:assignedAuthor lcg:uuid="00000000-0000-0000-0000-0000000000aa" lcg:unmatched="true">
                    <cda:id root="1.2.840.114350.1.13.212.2.7.1.1133" extension="9999999999" />
                    <cda:id root="2.16.840.1.113883.4.6" extension="9999999999" />
                </cda:assignedAuthor>
            </cda:author>
        </x:context>
        <x:expect label="produces a Practitioner, not a PractitionerRole"
            test="count(fhir:Practitioner) = 1 and count(fhir:PractitionerRole) = 0" />
        <x:expect label="claims us-core-practitioner"
            test="count(fhir:Practitioner/fhir:meta/fhir:profile[@value = 'http://hl7.org/fhir/us/core/StructureDefinition/us-core-practitioner']) = 1" />
        <x:expect label="both source ids are preserved as identifiers"
            test="count(fhir:Practitioner/fhir:identifier) = 2" />
        <x:expect label="the NPI id is mapped to the us-npi identifier system"
            test="count(fhir:Practitioner/fhir:identifier[fhir:system/@value = 'http://hl7.org/fhir/sid/us-npi'][fhir:value/@value = '9999999999']) = 1" />
        <x:expect label="name is genuinely absent in source, so family carries the data-absent-reason extension (us-core requires name.family)"
            test="count(fhir:Practitioner/fhir:name/fhir:family/fhir:extension[@url = 'http://hl7.org/fhir/StructureDefinition/data-absent-reason']/fhir:valueCode[@value = 'unknown']) = 1" />
    </x:scenario>

  <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-C1 / register item B18f): performers that
       carry no assignedPerson. Whole-pipeline test on integration-tests/documents/testPerf.xml, because the
       ids-only case is resolved in the update-referenced-actor-uuids phase. Before the fix this document had
       nine dangling performer references. -->
  <x:scenario label="P. performers without a person resolve (RT-C1)">
      <x:context href="../../integration-tests/documents/testPerf.xml" />
      <x:expect label="P1. every urn:uuid reference in the bundle resolves to an entry"
          test="every $r in //fhir:reference/@value[starts-with(., 'urn:uuid:')] satisfies $r = //fhir:entry/fhir:fullUrl/@value" />
      <x:expect label="P2. the ids-only performer used five times becomes exactly ONE identifier-only Practitioner"
          test="count(//fhir:Practitioner[fhir:identifier/fhir:value/@value = 'PERF-IDONLY']) = 1" />
      <x:expect label="P3. both ids-only immunizations point at that Practitioner"
          test="exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:Immunization[fhir:identifier/fhir:value/@value[ends-with(., 'f2000000-0000-0000-0000-000000000001')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Practitioner[fhir:identifier/fhir:value/@value = 'PERF-IDONLY']) and exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:Immunization[fhir:identifier/fhir:value/@value[ends-with(., 'f2000000-0000-0000-0000-000000000002')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Practitioner[fhir:identifier/fhir:value/@value = 'PERF-IDONLY'])" />
      <x:expect label="P4. an ids-only performer whose id matches the document author points at the author's PractitionerRole"
          test="exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:Immunization[fhir:identifier/fhir:value/@value[ends-with(., 'f2000000-0000-0000-0000-000000000003')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:PractitionerRole[fhir:practitioner])" />
      <x:expect label="P5. Immunization, organization-only performer: actor is the Organization"
          test="//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:Immunization[fhir:identifier/fhir:value/@value[ends-with(., 'f2000000-0000-0000-0000-000000000004')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Organization/fhir:name/@value = 'Performer Org 1'" />
      <x:expect label="P6. MedicationAdministration, organization-only performer: actor is a companion PractitionerRole with an organization and no practitioner"
          test="exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:MedicationAdministration[fhir:identifier/fhir:value/@value[ends-with(., 'f3000000-0000-0000-0000-000000000002')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:PractitionerRole[fhir:organization][not(fhir:practitioner)])" />
      <x:expect label="P7. that companion role's organization is Performer Org 2"
          test="//fhir:entry[fhir:fullUrl/@value = //fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:MedicationAdministration[fhir:identifier/fhir:value/@value[ends-with(., 'f3000000-0000-0000-0000-000000000002')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:PractitionerRole/fhir:organization/fhir:reference/@value]/fhir:resource/fhir:Organization/fhir:name/@value = 'Performer Org 2'" />
      <x:expect label="P8. MedicationDispense, organization-only performer: actor is the Organization"
          test="//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:MedicationDispense[fhir:identifier/fhir:value/@value[ends-with(., 'f4000000-0000-0000-0000-000000000001')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Organization/fhir:name/@value = 'Performer Org 3'" />
      <x:expect label="P9. MedicationAdministration and MedicationDispense ids-only performers point at the same Practitioner"
          test="exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:MedicationAdministration[fhir:identifier/fhir:value/@value[ends-with(., 'f3000000-0000-0000-0000-000000000001')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Practitioner) and exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:MedicationDispense[fhir:identifier/fhir:value/@value[ends-with(., 'f4000000-0000-0000-0000-000000000002')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:Practitioner)" />
      <x:expect label="P10. control: a complete person performer still points at a PractitionerRole with a practitioner"
          test="exists(//fhir:entry[fhir:fullUrl/@value = //fhir:entry/fhir:resource/fhir:Immunization[fhir:identifier/fhir:value/@value[ends-with(., 'f2000000-0000-0000-0000-000000000005')]]/fhir:performer/fhir:actor/fhir:reference/@value]/fhir:resource/fhir:PractitionerRole[fhir:practitioner])" />
  </x:scenario>
</x:description>
