<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir"
    xmlns:lcg="http://www.lantanagroup.com" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    stylesheet="../SaxonPE-cda2fhir.xslt" run-as="external">

    <!-- 20260729 Claude: regression tests for defects fixed 2026-07 - each scenario asserts the corrected
         behavior and fails against the pre-fix code -->

    <x:scenario label="Planned Intervention Act (4.146, moodCode INT) gets status active and its entryRelationships as action/resource">
        <x:context>
            <act classCode="ACT" moodCode="INT" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.146"/><id root="c1000000-0000-0000-0000-000000000001"/>
            <code code="362956003" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="active"/>
            <effectiveTime value="20260101"/>
            <entryRelationship typeCode="COMP"><observation classCode="OBS" moodCode="INT">
            <templateId root="2.16.840.1.113883.10.20.22.4.44"/><id root="c1000000-0000-0000-0000-000000000002"/>
            <code code="75325-1" codeSystem="2.16.840.1.113883.6.1"/><statusCode code="active"/>
            </observation></entryRelationship></act>
        </x:context>
        <x:expect label="Should produce a RequestGroup"
            test="count(fhir:RequestGroup) = 1" />
        <x:expect label="status should be 'active'"
            test="count(fhir:RequestGroup/fhir:status[@value = 'active']) = 1" />
        <x:expect label="The nested planned observation should appear as action/resource (was commented out 'for demo')"
            test="count(fhir:RequestGroup/fhir:action/fhir:resource) = 1" />
    </x:scenario>

    <x:scenario label="Intervention Act (4.131, moodCode EVN) gets status completed">
        <x:context>
            <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.131"/><id root="c2000000-0000-0000-0000-000000000001"/>
            <code code="362956003" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="completed"/></act>
        </x:context>
        <x:expect label="status should be 'completed'"
            test="count(fhir:RequestGroup/fhir:status[@value = 'completed']) = 1" />
    </x:scenario>

    <x:scenario label="Unexpected mood/template combination still emits the required status (unknown)">
        <x:context>
            <act classCode="ACT" moodCode="EVN" xmlns="urn:hl7-org:v3">
            <templateId root="2.16.840.1.113883.10.20.22.4.146"/><id root="c3000000-0000-0000-0000-000000000001"/>
            <code code="362956003" codeSystem="2.16.840.1.113883.6.96"/><statusCode code="completed"/></act>
        </x:context>
        <x:expect label="RequestGroup.status is required 1..1 - must be present even for unexpected mood/template combinations"
            test="count(fhir:RequestGroup/fhir:status) = 1" />
        <x:expect label="status should default to 'unknown'"
            test="count(fhir:RequestGroup/fhir:status[@value = 'unknown']) = 1" />
    </x:scenario>

</x:description>
