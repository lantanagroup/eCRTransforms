<?xml version="1.0" encoding="UTF-8"?>
<!-- 20260730 Claude: created alongside the effectiveTime fixes in cda2fhir-RiskAssessment.xslt. Nothing in the
     pipeline currently reaches create-risk (the 4.136 Risk Concern Act is unwrapped as a Concern wrapper by
     cda2fhir-Condition.xslt - see the REACHABILITY NOTE in the stylesheet), so these scenarios call the named
     template directly on inline fragments. The $condition param is deliberately omitted: it is not what these
     scenarios test, and create-risk tolerates its absence. -->
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" stylesheet="../NativeUUIDGen-cda2fhir.xslt"
    xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" xmlns:lcg="http://www.lantanagroup.com" run-as="external">

    <x:scenario label="create-risk: effectiveTime/@value maps to occurrenceDateTime (was applied to the act, leaking through built-in rules)">
        <x:context>
            <act xmlns="urn:hl7-org:v3" classCode="ACT" moodCode="EVN">
                <templateId root="2.16.840.1.113883.10.20.22.4.136" />
                <id root="90000000-0000-0000-0000-000000000001" />
                <code code="281694009" codeSystem="2.16.840.1.113883.6.96" />
                <statusCode code="active" />
                <effectiveTime value="20250115" />
            </act>
        </x:context>
        <x:call template="create-risk" />
        <x:expect label="occurrenceDateTime carries the converted date"
            test="count(fhir:RiskAssessment/fhir:occurrenceDateTime[@value = '2025-01-15']) = 1" />
        <x:expect label="no stray 'date' element (the instant-mode default when params are lost to built-in rules)"
            test="count(fhir:RiskAssessment/fhir:date) = 0" />
    </x:scenario>

    <x:scenario label="create-risk: null-flavored effectiveTime produces no occurrence[x] (the test used to read the ACT's nullFlavor)">
        <x:context>
            <act xmlns="urn:hl7-org:v3" classCode="ACT" moodCode="EVN">
                <templateId root="2.16.840.1.113883.10.20.22.4.136" />
                <id root="90000000-0000-0000-0000-000000000002" />
                <code code="281694009" codeSystem="2.16.840.1.113883.6.96" />
                <statusCode code="active" />
                <effectiveTime nullFlavor="UNK" />
            </act>
        </x:context>
        <x:call template="create-risk" />
        <x:expect label="no occurrenceDateTime" test="count(fhir:RiskAssessment/fhir:occurrenceDateTime) = 0" />
        <x:expect label="no occurrencePeriod (the null effectiveTime used to fall through to the period branch)"
            test="count(fhir:RiskAssessment/fhir:occurrencePeriod) = 0" />
    </x:scenario>

    <x:scenario label="create-risk: effectiveTime low/high maps to occurrencePeriod">
        <x:context>
            <act xmlns="urn:hl7-org:v3" classCode="ACT" moodCode="EVN">
                <templateId root="2.16.840.1.113883.10.20.22.4.136" />
                <id root="90000000-0000-0000-0000-000000000003" />
                <code code="281694009" codeSystem="2.16.840.1.113883.6.96" />
                <statusCode code="active" />
                <effectiveTime>
                    <low value="20240201" />
                    <high value="20240315" />
                </effectiveTime>
            </act>
        </x:context>
        <x:call template="create-risk" />
        <x:expect label="occurrencePeriod.start" test="count(fhir:RiskAssessment/fhir:occurrencePeriod/fhir:start[@value = '2024-02-01']) = 1" />
        <x:expect label="occurrencePeriod.end" test="count(fhir:RiskAssessment/fhir:occurrencePeriod/fhir:end[@value = '2024-03-15']) = 1" />
    </x:scenario>

</x:description>
