<?xml version="1.0" encoding="UTF-8"?>
<x:description xmlns:x="http://www.jenitennison.com/xslt/xspec" xmlns:cda="urn:hl7-org:v3" xmlns:fhir="http://hl7.org/fhir" 
    xmlns:lcg="http://www.lantanagroup.com" stylesheet="../NativeUUIDGen-cda2fhir.xslt" run-as="external">
    
    <!-- Specimen Collection Procedure - Create Specimen bundle entry -->
    <x:scenario
        label="Scenario for testing template cda:procedure[cda:templateId[@root='2.16.840.1.113883.10.20.22.4.415']">
        <x:context href="../../../samples/cda/xspec-test-files/XSPEC_eICR-CDA-001_R3_1.xml" />
        <x:expect label="There should be two Specimen resources" 
            test="count(//fhir:Specimen) = 2" />
        
        <x:expect label="The specimen should have identifier 44fd0410-6115-4b8e-8ee9-a51b3817df66" 
            test="count(//fhir:Specimen/fhir:identifier/fhir:value[@value='urn:uuid:44fd0410-6115-4b8e-8ee9-a51b3817df66']) = 1" />
        <x:expect label="The specimen should have identifier 44fd0410-6115-4b8e-8ee9-a51b3817df67" 
            test="count(//fhir:Specimen/fhir:identifier/fhir:value[@value='urn:uuid:44fd0410-6115-4b8e-8ee9-a51b3817df67']) = 1" />
        
        <x:expect label="The specimen should have type = 119297000" 
            test="count(//fhir:Specimen/fhir:type/fhir:coding/fhir:code[@value='119297000']) = 2" />
        <x:expect label="The specimen should have collectedPeriod.start = 2020-03-09" 
            test="count(//fhir:Specimen/fhir:collection/fhir:collectedPeriod/fhir:start[@value='2020-03-09']) = 2" />
        <x:expect label="The specimen should have bodySite = 368208006" 
            test="count(//fhir:Specimen/fhir:collection/fhir:bodySite/fhir:coding/fhir:code[@value='368208006']) = 2" />
        
        <!-- 20260729 Claude: Fix - the two assertions here were identical duplicates and their labels said
             'available' while the test checked 'unavailable' (per specimen-status-mapping.xml, aborted/obsolete map
             to unavailable); deduplicated and label aligned with the test -->
        <x:expect label="One specimen should have status='unavailable'"
            test="count(//fhir:Specimen/fhir:status[@value='unavailable']) = 1" />
        <!-- 20260729 Claude: regression test for the 2026-07 fix - Specimen previously emitted no subject
             (US Core Specimen requires subject 1..1) -->
        <x:expect label="Every Specimen should have a subject"
            test="count(//fhir:Specimen[not(fhir:subject)]) = 0" />
    </x:scenario>

    <!-- 20261124 Claude (SG decision 2026-11-24, re-trace finding RT-C17): the Specimen took its identifier
         and type from EVERY participant of the Specimen Collection Procedure. The specimen is the
         participant with typeCode PRD; another participant (a location, for example) added a second
         identifier and a second Specimen.type, which is 0..1. Only the PRD participant is read now. -->
    <x:scenario label="S. Specimen reads only the PRD participant (RT-C17)">
        <x:scenario label="S1. specimen participant plus a location participant">
            <x:context select="//cda:procedure">
            <ClinicalDocument xmlns="urn:hl7-org:v3" lcg:uuid="00000000-0000-0000-0000-000000000da0">
                <templateId root="2.16.840.1.113883.10.20.15.2" extension="2022-05-01" />
                <recordTarget lcg:uuid="00000000-0000-0000-0000-000000000da9"><patientRole><id root="2.16.840.1.113883.19.5" extension="MRN-1" /></patientRole></recordTarget>
                <component><structuredBody><component><section>
                    <templateId root="2.16.840.1.113883.10.20.22.2.3.1" extension="2015-08-01" />
                    <code code="30954-2" codeSystem="2.16.840.1.113883.6.1" />
                    <entry><organizer classCode="BATTERY" moodCode="EVN">
                        <templateId root="2.16.840.1.113883.10.20.22.4.1" extension="2015-08-01" />
                        <component>
                            <procedure classCode="PROC" moodCode="EVN" lcg:uuid="00000000-0000-0000-0000-000000000da1">
                                <templateId root="2.16.840.1.113883.10.20.22.4.415" extension="2018-09-01" />
                                <code code="17636008" codeSystem="2.16.840.1.113883.6.96" displayName="Specimen collection" />
                                <participant typeCode="PRD">
                                    <participantRole classCode="SPEC">
                                        <id root="2.16.840.1.113883.19.5" extension="SPEC-1" />
                                        <playingEntity><code code="122555007" codeSystem="2.16.840.1.113883.6.96" displayName="Venous blood specimen" /></playingEntity>
                                    </participantRole>
                                </participant>
                                <participant typeCode="LOC">
                                    <participantRole classCode="SDLOC">
                                        <id root="2.16.840.1.113883.19.5" extension="LOC-1" />
                                        <playingEntity classCode="PLC"><code code="1160-1" codeSystem="2.16.840.1.113883.6.259" displayName="Urgent Care Center" /></playingEntity>
                                    </participantRole>
                                </participant>
                            </procedure>
                        </component>
                    </organizer></entry>
                </section></component></structuredBody></component>
            </ClinicalDocument>
            </x:context>
            <x:expect label="S1a. exactly one Specimen.type" test="count(fhir:Specimen/fhir:type) = 1" />
            <x:expect label="S1b. it is the specimen's type" test="fhir:Specimen/fhir:type/fhir:coding/fhir:code/@value = '122555007'" />
            <x:expect label="S1c. exactly one identifier, the specimen's" test="count(fhir:Specimen/fhir:identifier) = 1 and fhir:Specimen/fhir:identifier/fhir:value/@value = 'SPEC-1'" />
        </x:scenario>
        <x:scenario label="S2. control: specimen participant only">
            <x:context select="//cda:procedure">
            <ClinicalDocument xmlns="urn:hl7-org:v3" lcg:uuid="00000000-0000-0000-0000-000000000da0">
                <templateId root="2.16.840.1.113883.10.20.15.2" extension="2022-05-01" />
                <recordTarget lcg:uuid="00000000-0000-0000-0000-000000000da9"><patientRole><id root="2.16.840.1.113883.19.5" extension="MRN-1" /></patientRole></recordTarget>
                <component><structuredBody><component><section>
                    <templateId root="2.16.840.1.113883.10.20.22.2.3.1" extension="2015-08-01" />
                    <code code="30954-2" codeSystem="2.16.840.1.113883.6.1" />
                    <entry><organizer classCode="BATTERY" moodCode="EVN">
                        <templateId root="2.16.840.1.113883.10.20.22.4.1" extension="2015-08-01" />
                        <component>
                            <procedure classCode="PROC" moodCode="EVN" lcg:uuid="00000000-0000-0000-0000-000000000da1">
                                <templateId root="2.16.840.1.113883.10.20.22.4.415" extension="2018-09-01" />
                                <code code="17636008" codeSystem="2.16.840.1.113883.6.96" displayName="Specimen collection" />
                                <participant typeCode="PRD">
                                    <participantRole classCode="SPEC">
                                        <id root="2.16.840.1.113883.19.5" extension="SPEC-1" />
                                        <playingEntity><code code="122555007" codeSystem="2.16.840.1.113883.6.96" displayName="Venous blood specimen" /></playingEntity>
                                    </participantRole>
                                </participant>
                            </procedure>
                        </component>
                    </organizer></entry>
                </section></component></structuredBody></component>
            </ClinicalDocument>
            </x:context>
            <x:expect label="S2a. type and identifier from the specimen participant" test="fhir:Specimen/fhir:type/fhir:coding/fhir:code/@value = '122555007' and fhir:Specimen/fhir:identifier/fhir:value/@value = 'SPEC-1'" />
        </x:scenario>
    </x:scenario>
</x:description>
